---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site.ts';
---

<Layout title={`${site.writer.name} — Commissions`}>
  <main class="home">
    <header class="hero">
      <img
        src={site.writer.photo}
        alt={`Portrait of ${site.writer.name}`}
        class="portrait"
        width="320"
        height="320"
      />
      <h1 class="name" transition:name="writer-name">{site.writer.name}</h1>
      <p class="tagline">{site.writer.tagline}</p>
    </header>

    <nav class="primary-nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a class="nav-button" href={item.href}>
            {item.label}
          </a>
        ))
      }
      <a
        class="nav-button nav-button--external"
        href={site.queueUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Queue
        <span aria-hidden="true" class="external-icon">↗</span>
      </a>
    </nav>

    <footer class="socials" aria-label="Social links">
      <ul>
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} aria-label={`${s.name} — ${s.handle}`}>
                {s.name}
              </a>
            </li>
          ))
        }
      </ul>
    </footer>
  </main>
</Layout>
