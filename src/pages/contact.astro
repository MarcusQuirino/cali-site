---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site.ts';
---

<Layout
  title={`Contact Everayy — Commissioned Fiction Writer & Custom Prose`}
  description="Reach Everayy for fiction commissions, collaborations, or general inquiries. Find links to all social channels and the live commission queue."
>
  <main class="page">
    <a href="/" class="back-link" aria-label="Back to home">← Back</a>
    <header class="page-header">
      <h1 transition:name="page-title">Contact</h1>
      <p class="lede">
        Find me across the internet. Check the queue board before reaching
        out to see if I'm currently open for commissions.
      </p>
    </header>

    <section class="contact-links" aria-labelledby="links-heading">
      <h2 id="links-heading">Find Me</h2>
      <ul class="link-cards">
        {
          site.socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="link-card"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="link-card__platform">{s.name}</span>
                <span class="link-card__handle">{s.handle}</span>
                <span class="link-card__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="mailto:everayywrites@gmail.com"
            class="link-card link-card--email"
          >
            <span class="link-card__platform">Email</span>
            <span class="link-card__handle">everayywrites@gmail.com</span>
            <span class="link-card__arrow" aria-hidden="true">✉</span>
          </a>
        </li>
        <li>
          <a
            href={site.queueUrl}
            class="link-card link-card--queue"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="link-card__platform">Commission Queue</span>
            <span class="link-card__handle">Trello board</span>
            <span class="link-card__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>

<style>
  .contact-links {
    background: var(--paper);
    border: var(--border-w) solid var(--ink);
    box-shadow: var(--shadow-md);
    padding: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .link-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.85rem 1rem;
    background: var(--paper);
    border: var(--border-w) solid var(--ink);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--ink);
    overflow: hidden; /* clip anything that escapes */
    transition:
      transform var(--press),
      box-shadow var(--press),
      background var(--press);
  }

  .link-card:hover {
    background: var(--mint);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-md);
  }

  .link-card:active {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--ink);
  }

  .link-card--email {
    background: var(--mint);
  }

  .link-card--email:hover {
    background: var(--paper);
  }

  .link-card--queue {
    background: var(--navy);
    color: var(--paper);
  }

  .link-card--queue:hover {
    background: var(--ink);
    color: var(--mint);
  }

  .link-card__platform {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    flex: 0 0 auto;
  }

  .link-card__handle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    opacity: 0.75;
    flex: 1;
    min-width: 0;           /* allow flex item to shrink below content width */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-card--queue .link-card__handle {
    opacity: 0.8;
  }

  .link-card__arrow {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    flex: 0 0 auto;
    margin-left: auto;
  }

  @media (min-width: 640px) {
    .link-cards {
      grid-template-columns: repeat(2, 1fr);
    }

    .link-cards li:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
